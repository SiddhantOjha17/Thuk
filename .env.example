# ── Database — Supabase (free, no CC) ─────────────────────────────────────────
# postgresql+asyncpg://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/thuk
# true for Supabase / hosted PostgreSQL, false for local Docker
DB_SSL=false

# ── Redis — Upstash (free, no CC) ─────────────────────────────────────────────
# rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
REDIS_URL=redis://localhost:6379

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Primary: Groq — free at https://console.groq.com
GROQ_API_KEY=gsk_...

# Image processing + fallback: Gemini — free at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Voice transcription (Whisper) + emergency fallback: OpenAI
OPENAI_API_KEY=sk-...

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_here

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── Deployment ────────────────────────────────────────────────────────────────
# Your Koyeb app URL — set after first deploy
WEBHOOK_BASE_URL=https://YOUR_APP.koyeb.app
